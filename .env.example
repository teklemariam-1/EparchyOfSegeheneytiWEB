# ─────────────────────────────────────────────
# Eparchy of Segeneyti — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control
# ─────────────────────────────────────────────

# ── Database ─────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URI=postgresql://postgres:password@localhost:5432/eparchy_segeneyti

# ── Payload CMS ──────────────────────────────
# Must be a strong random string (min 32 chars)
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ── Next.js ───────────────────────────────────
# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Media / File Storage ─────────────────────
# Set STORAGE_ADAPTER to 'local' (dev) or 's3' (production)
STORAGE_ADAPTER=local

# S3-compatible storage (Cloudflare R2, AWS S3, MinIO, etc.)
# Only required when STORAGE_ADAPTER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_HOSTNAME=pub-<id>.r2.dev

# ── Email Transport ───────────────────────────
# Payload uses email for password reset, form notifications, etc.
# Configure ONE of the following transport methods:
#
# OPTION A: Resend (recommended for Vercel)
# Sign up at https://resend.com and create an API key
# RESEND_API_KEY=re_xxxxxxxxxxxxx
#
# OPTION B: SMTP (Gmail, SendGrid, Mailgun, Amazon SES, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@segeneyti.org
# SMTP_PASS=your-smtp-password
#
# OPTION C: No email transport (development only)
# Leave all email vars empty — reset links are logged to the terminal.

# Sender identity (used by both Resend and SMTP)
PAYLOAD_FROM_ADDRESS=noreply@segeneyti.org
PAYLOAD_FROM_NAME=Eparchy of Segeneyti CMS

# Contact form notification recipient
CONTACT_NOTIFICATION_EMAIL=chancery@segeneyti.org

# Where donation notifications go. Falls back to CONTACT_NOTIFICATION_EMAIL.
DONATION_NOTIFICATION_EMAIL=

# ── Stripe (card donations) ───────────────────────────────────────────────────
#
# ⚠ ENTITY: Stripe does NOT support Eritrea as a business or payout country.
# A live account requires a legal entity registered in a supported country —
# a diaspora support association, a partner diocese, or a fiscal sponsor —
# with a bank account there. The account's country, settlement currency and
# payout schedule are properties of the key below, not of this codebase.
# Resolve the entity before switching donation-settings to a card method.
#
# Leaving STRIPE_SECRET_KEY empty is safe and supported: the card option is
# suppressed automatically and donations fall back to manual transfer.
#
# Secret key — server only, NEVER exposed to the browser. sk_test_… in dev.
STRIPE_SECRET_KEY=

# Webhook signing secret for /api/webhooks/stripe.
# Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints
# a whsec_… — use that one. Production: copy it from the endpoint you create in
# the Stripe dashboard. They are DIFFERENT secrets; using the wrong one makes
# every event fail signature verification.
STRIPE_WEBHOOK_SECRET=

# Publishable key. Safe to expose — it is the only Stripe value with a
# NEXT_PUBLIC_ prefix. Not required by hosted Checkout (the redirect happens
# server-side); set it only if the Payment Element or Stripe.js is ever added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Analytics (optional) ─────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Feature Flags ─────────────────────────────
# Enable/disable multilingual support
NEXT_PUBLIC_ENABLE_TIGRINYA=true
NEXT_PUBLIC_ENABLE_ARABIC=false
