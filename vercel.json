{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/ingest/vatican-news?feed=all&limit=15",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/scheduled-publish",
      "schedule": "30 3 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
